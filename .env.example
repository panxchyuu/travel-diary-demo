# Copy to .env on the server; fill in your own key and model ID.
# Or configure the same names in your deployment platform Environment/Secrets.
MODEL_PROVIDER=openai-compatible
# Optional: override the default listening port (4173).
# PORT=4173
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=your-function-calling-model-id
OPENAI_API_KEY=

# The endpoint must support Responses API + function calling (strict tools).
# Diary / expense extraction also requires JSON object output and low reasoning.
# Changing configuration requires restarting the Node service.

# Optional local-only alternative: reuse this machine's Codex configuration.
# MODEL_PROVIDER=codex
# CODEX_MODEL=your-local-model-id
# Never upload ~/.codex/auth.json or any real credentials.
